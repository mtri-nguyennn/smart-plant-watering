# Server
PORT=3000

# Comma-separated frontend origins. Requests without Origin (ESP32/curl) are allowed.
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080

# Optional device authentication. Leave empty during local development.
# If set, use the same value in ESP32 DEVICE_API_KEY.
DEVICE_API_KEY=

# Device is considered offline when no reading/command poll/result is seen within this time.
DEVICE_ONLINE_TIMEOUT_MS=15000

# Sensor calibration: capacitive sensor typically has a lower raw value when wet.
MOISTURE_RAW_WET=3000
MOISTURE_RAW_DRY=4000

# Soil-condition thresholds based on calculated moisture percentage.
SOIL_DRY_MAX_PERCENT=30
SOIL_MOIST_MAX_PERCENT=65

# Safety limit enforced by backend. ESP32 also has its own independent limit.
MAX_PUMP_DURATION_SEC=30
